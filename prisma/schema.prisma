// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  codeExpiry  DateTime

  owner       Profile   @relation("GroupOwner", fields: [ownerId], references: [userId])
  ownerId     String    @unique

  member      Profile?  @relation("GroupMember", fields: [memberId], references: [userId])
  memberId    String?    @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Profile {
  id          Int       @id @default(autoincrement())
  userId      String    @unique @map("user_id")
  name        String
  imageUrl    String?   @db.Text

  ownedGroup   Group?   @relation("GroupOwner")
  memberGroup  Group?   @relation("GroupMember")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}